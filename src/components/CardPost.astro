---
interface Props {
    url: string;
    image: string;
    title: string;
    date: string;
    // A draft is only shown in the UT mode.
    draft?: boolean;
}

const { url, image, title, date, draft = false } = Astro.props;
---

<li class:list={["card", { "dev-only": draft }]}>
    <a class="card__link" href={url}>
        <div class="center">
            <img
                class="card__img"
                src={image}
                role="presentation"
                width="226"
                height="127"
                loading="lazy"
                decoding="async"
            />
        </div>
        <h3 class="card__title">
            {title}
        </h3>
    </a>
</li>
