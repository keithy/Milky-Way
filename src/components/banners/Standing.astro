---
/*
 * The standing banner.
 *
 * A figure with his arms folded, standing on a cloud.
 *
 * He is taller than he is wide, so where the other artworks fill the
 * width of the banner, this one fills its height and leaves the rest
 * of the banner to the cloud.
 */
interface Props {
    alt?: string;
}

const { alt = "" } = Astro.props;
---

<div class="banner">
    <img class="banner__front" src="/images/banners/banner-standing.webp" alt={alt} />
</div>

<style>
    /*
     * The banner is a fixed space on the page: five hundred and forty by
     * two hundred and twenty. The cloud fills it, and the figure stands
     * on it.
     */
    .banner {
        position: relative;
        width: 540px;
        max-width: 100%;
        aspect-ratio: 540 / 300;
        margin: 20px auto 1rem;
        line-height: 0;
        overflow: hidden;
    }

    /*
     * The layers are stacked rather than laid out in a row, and each
     * carries an explicit z-index. That matters: an absolutely
     * positioned element with z-index auto paints above in-flow
     * content, so leaving the figure static would put the cloud on top
     * of it. The depths say which is which.
     */
    .banner__front {
        position: absolute;
        display: block;
    }

    /*
     * The figure.
     *
     * He is taller than he is wide, so the image is scaled until the
     * drawing is as tall as the banner, and centred in it. That makes
     * him about a hundred and forty pixels wide, so the rest of the
     * banner is cloud.
     *
     * The width and the height are the drawing's own proportions, so the
     * figure is not squashed.
     */
    .banner__front {
        z-index: 1;
        width: 36.73%;
        height: 100%;
        left: 50%;
        top: 0;
        transform: translateX(-50%);
    }
</style>
