---
/*
 * The cloud under an artwork.
 *
 * The cloud is an SVG of overlapping radial gradients rather than a
 * picture. That matters for two reasons. It is a fraction of the size
 * of the raster it replaces, and — because a gradient has no key
 * colour in it — it cannot show the fringe that a chroma-keyed image
 * leaves at its edges.
 *
 * The cloud is one shape and it does not move. A cloud that drifts is
 * a cloud the reader watches rather than reads, and a banner is
 * furniture: it should be there and be still.
 *
 * Each piece of artwork gets its own component, but the cloud is shared
 * between them, because the mechanism is the same whatever sits on it.
 */
interface Props {
    /*
     * Where the cloud sits, in the banner's own pixels.
     *
     * The centre is the middle of the cloud, and the baseline is the
     * height of its bottom. An artwork says where its own footing is,
     * and the cloud is placed under it.
     */
    center?: number;
    baseline?: number;

    /*
     * How wide the cloud is, and how tall it is as a proportion of its
     * width. A cloud under a plinth is an ovoid, so it is wider than it
     * is tall.
     */
    width?: number;
    height?: number;
}

const { center = 270, baseline = 220, width = 300, height = 0.42 } = Astro.props;

/*
 * The cloud.
 *
 * One soft-edged ovoid, wider than it is tall, lying under the
 * artwork's footing. It is the shape of the base it carries: a plinth
 * seen slightly from above, so it reads as the same perspective rather
 * than as a puff of vapour.
 *
 * It is drawn as two overlapping ellipses rather than one, because a
 * single ellipse with a radial gradient has a hard centre and a soft
 * edge, and the two together give a shape with a soft edge and a soft
 * middle.
 */
const lobes = [
    {
        cx: center,
        cy: baseline - (height * width) / 2,
        rx: width / 2,
        ry: (height * width) / 2,
        opacity: 0.9,
    },
    {
        cx: center - width * 0.16,
        cy: baseline - (height * width) / 2 + height * width * 0.06,
        rx: width * 0.36,
        ry: (height * width) * 0.44,
        opacity: 0.75,
    },
    {
        cx: center + width * 0.18,
        cy: baseline - (height * width) / 2 + height * width * 0.08,
        rx: width * 0.32,
        ry: (height * width) * 0.38,
        opacity: 0.7,
    },
];
---

<svg class="cloud" viewBox="0 0 540 220" width="540" height="220" preserveAspectRatio="none" aria-hidden="true">
<defs>
{lobes.map((lobe, i) => (
    <radialGradient id={`cl${i}`}>
        <stop offset="0%" stop-color="var(--cloud-core)" stop-opacity="1" />
        <stop offset="45%" stop-color="var(--cloud-core)" stop-opacity="0.75" />
        <stop offset="100%" stop-color="var(--cloud-core)" stop-opacity="0" />
    </radialGradient>
))}
</defs>
{lobes.map((lobe, i) => (
    <ellipse cx={lobe.cx} cy={lobe.cy} rx={lobe.rx} ry={lobe.ry} fill={`url(#cl${i})`} opacity={lobe.opacity} />
))}
</svg>

<style>
    /*
     * The cloud is drawn in the banner's own pixels — five hundred and
     * forty by two hundred and twenty — so it needs no scaling and no
     * mask. Each of its lobes is a radial gradient that fades to
     * nothing at its edge, and the gradient is the shape.
     *
     * The cloud's colour comes from the theme rather than from the
     * drawing, so the same shape serves both grounds. It is darker than
     * white on both: on the dark ground a white cloud is a hole in the
     * sky, and on the light ground it disappears into the page.
     */
    .cloud {
        position: absolute;
        z-index: 0;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;

        --cloud-core: #a8bccd;
    }

    :global(.light) .cloud {
        --cloud-core: #93aac0;
    }
</style>
