---
/*
 * The warrior banner.
 *
 * The artwork is in two layers: the cloud behind, and the warrior at
 * the desk in front.
 *
 * The cloud is an SVG of overlapping radial gradients rather than a
 * picture. That matters for two reasons. It is a fifteenth of the size
 * of the raster it replaces, and — because a gradient has no key
 * colour in it — it cannot show the pink fringe that a chroma-keyed
 * image leaves at its edges.
 *
 * Each piece of artwork gets its own component, because each needs its
 * own tweaking. This one owns its own CSS rather than putting it in
 * the global stylesheet.
 */
interface Props {
    alt?: string;
}

const { alt = "" } = Astro.props;
---

<div class="banner">
    <svg class="banner__cloud banner__cloud--a" viewBox="0 0 540 220" width="540" height="220" preserveAspectRatio="none" aria-hidden="true">
<defs>
<radialGradient id="ca0"><stop offset="0%" stop-color="var(--cloud-core)" stop-opacity="1"/><stop offset="45%" stop-color="var(--cloud-core)" stop-opacity="0.75"/><stop offset="100%" stop-color="var(--cloud-core)" stop-opacity="0"/></radialGradient>
<radialGradient id="ca1"><stop offset="0%" stop-color="var(--cloud-core)" stop-opacity="1"/><stop offset="45%" stop-color="var(--cloud-core)" stop-opacity="0.75"/><stop offset="100%" stop-color="var(--cloud-core)" stop-opacity="0"/></radialGradient>
<radialGradient id="ca2"><stop offset="0%" stop-color="var(--cloud-core)" stop-opacity="1"/><stop offset="45%" stop-color="var(--cloud-core)" stop-opacity="0.75"/><stop offset="100%" stop-color="var(--cloud-core)" stop-opacity="0"/></radialGradient>
<radialGradient id="ca3"><stop offset="0%" stop-color="var(--cloud-core)" stop-opacity="1"/><stop offset="45%" stop-color="var(--cloud-core)" stop-opacity="0.75"/><stop offset="100%" stop-color="var(--cloud-core)" stop-opacity="0"/></radialGradient>
<radialGradient id="ca4"><stop offset="0%" stop-color="var(--cloud-core)" stop-opacity="1"/><stop offset="45%" stop-color="var(--cloud-core)" stop-opacity="0.75"/><stop offset="100%" stop-color="var(--cloud-core)" stop-opacity="0"/></radialGradient>
<radialGradient id="ca5"><stop offset="0%" stop-color="var(--cloud-core)" stop-opacity="1"/><stop offset="45%" stop-color="var(--cloud-core)" stop-opacity="0.75"/><stop offset="100%" stop-color="var(--cloud-core)" stop-opacity="0"/></radialGradient>
<radialGradient id="ca6"><stop offset="0%" stop-color="var(--cloud-core)" stop-opacity="1"/><stop offset="45%" stop-color="var(--cloud-core)" stop-opacity="0.75"/><stop offset="100%" stop-color="var(--cloud-core)" stop-opacity="0"/></radialGradient>
<radialGradient id="ca7"><stop offset="0%" stop-color="var(--cloud-core)" stop-opacity="1"/><stop offset="45%" stop-color="var(--cloud-core)" stop-opacity="0.75"/><stop offset="100%" stop-color="var(--cloud-core)" stop-opacity="0"/></radialGradient>
</defs>
<ellipse cx="270" cy="155" rx="195" ry="62" fill="url(#ca0)" opacity="1.0"/>
<ellipse cx="150" cy="165" rx="120" ry="50" fill="url(#ca1)" opacity="0.85"/>
<ellipse cx="390" cy="165" rx="120" ry="50" fill="url(#ca2)" opacity="0.85"/>
<ellipse cx="80" cy="180" rx="70" ry="38" fill="url(#ca3)" opacity="0.55"/>
<ellipse cx="460" cy="180" rx="70" ry="38" fill="url(#ca4)" opacity="0.55"/>
<ellipse cx="205" cy="135" rx="115" ry="50" fill="url(#ca5)" opacity="0.7"/>
<ellipse cx="335" cy="135" rx="115" ry="50" fill="url(#ca6)" opacity="0.7"/>
<ellipse cx="270" cy="120" rx="125" ry="45" fill="url(#ca7)" opacity="0.5"/>
</svg>
    <svg class="banner__cloud banner__cloud--b" viewBox="0 0 540 220" width="540" height="220" preserveAspectRatio="none" aria-hidden="true">
<defs>
<radialGradient id="cb0"><stop offset="0%" stop-color="var(--cloud-core)" stop-opacity="1"/><stop offset="45%" stop-color="var(--cloud-core)" stop-opacity="0.75"/><stop offset="100%" stop-color="var(--cloud-core)" stop-opacity="0"/></radialGradient>
<radialGradient id="cb1"><stop offset="0%" stop-color="var(--cloud-core)" stop-opacity="1"/><stop offset="45%" stop-color="var(--cloud-core)" stop-opacity="0.75"/><stop offset="100%" stop-color="var(--cloud-core)" stop-opacity="0"/></radialGradient>
<radialGradient id="cb2"><stop offset="0%" stop-color="var(--cloud-core)" stop-opacity="1"/><stop offset="45%" stop-color="var(--cloud-core)" stop-opacity="0.75"/><stop offset="100%" stop-color="var(--cloud-core)" stop-opacity="0"/></radialGradient>
<radialGradient id="cb3"><stop offset="0%" stop-color="var(--cloud-core)" stop-opacity="1"/><stop offset="45%" stop-color="var(--cloud-core)" stop-opacity="0.75"/><stop offset="100%" stop-color="var(--cloud-core)" stop-opacity="0"/></radialGradient>
<radialGradient id="cb4"><stop offset="0%" stop-color="var(--cloud-core)" stop-opacity="1"/><stop offset="45%" stop-color="var(--cloud-core)" stop-opacity="0.75"/><stop offset="100%" stop-color="var(--cloud-core)" stop-opacity="0"/></radialGradient>
<radialGradient id="cb5"><stop offset="0%" stop-color="var(--cloud-core)" stop-opacity="1"/><stop offset="45%" stop-color="var(--cloud-core)" stop-opacity="0.75"/><stop offset="100%" stop-color="var(--cloud-core)" stop-opacity="0"/></radialGradient>
<radialGradient id="cb6"><stop offset="0%" stop-color="var(--cloud-core)" stop-opacity="1"/><stop offset="45%" stop-color="var(--cloud-core)" stop-opacity="0.75"/><stop offset="100%" stop-color="var(--cloud-core)" stop-opacity="0"/></radialGradient>
<radialGradient id="cb7"><stop offset="0%" stop-color="var(--cloud-core)" stop-opacity="1"/><stop offset="45%" stop-color="var(--cloud-core)" stop-opacity="0.75"/><stop offset="100%" stop-color="var(--cloud-core)" stop-opacity="0"/></radialGradient>
</defs>
<ellipse cx="330" cy="130" rx="120" ry="78" fill="url(#cb0)" opacity="1.0"/>
<ellipse cx="400" cy="145" rx="95" ry="62" fill="url(#cb1)" opacity="0.9"/>
<ellipse cx="250" cy="165" rx="110" ry="45" fill="url(#cb2)" opacity="0.75"/>
<ellipse cx="150" cy="178" rx="95" ry="34" fill="url(#cb3)" opacity="0.55"/>
<ellipse cx="75" cy="185" rx="60" ry="26" fill="url(#cb4)" opacity="0.35"/>
<ellipse cx="470" cy="175" rx="60" ry="30" fill="url(#cb5)" opacity="0.4"/>
<ellipse cx="300" cy="95" rx="80" ry="50" fill="url(#cb6)" opacity="0.5"/>
<ellipse cx="355" cy="88" rx="55" ry="38" fill="url(#cb7)" opacity="0.38"/>
</svg>
    <img
        class="banner__front"
        src="/images/banner-warrior-front.webp"
        alt={alt}
    />
</div>

<style>
    /*
     * The banner is a fixed space on the page: five hundred and forty by
     * two hundred and twenty. Both layers are drawn to that size.
     *
     * The cloud is an SVG drawn in the banner's own pixels, so it needs
     * no scaling and no mask — each of its lobes is a radial gradient
     * that fades to nothing at its edge, and the gradient is the shape.
     *
     * The figure is scaled down from the artwork until its drawing is two
     * hundred and twenty tall — the height of the banner — and centred
     * in it.
     */
    .banner {
        position: relative;
        width: 540px;
        max-width: 100%;
        aspect-ratio: 540 / 220;
        margin: 20px auto 1rem;
        line-height: 0;
        overflow: hidden;
    }

    /*
     * The two layers sit on top of each other, so they have to be stacked
     * rather than laid out in a row.
     *
     * Both are positioned, and both carry an explicit z-index. That
     * matters: an absolutely positioned element with z-index auto paints
     * above in-flow content, so leaving the front layer static would put
     * the cloud on top of the figure. The depths say which is which.
     */
    .banner__cloud,
    .banner__front {
        position: absolute;
        display: block;
    }

    .banner__cloud {
        z-index: 0;
        inset: 0;
        width: 100%;
        height: 100%;

        /*
         * The cloud's colour comes from the theme rather than from the
         * drawing, so the same shape serves both grounds.
         *
         * It is darker than white on both grounds: on the dark ground a
         * white cloud is a hole in the sky, and on the light ground it
         * disappears into the page.
         */
        --cloud-core: #a8bccd;
    }

    :global(.light) .banner__cloud {
        --cloud-core: #93aac0;
    }

    /*
     * The cloud drifts.
     *
     * There are two shapes, and they cross-fade between each other over
     * ten seconds. The shape itself is animated as a set of ellipses
     * rather than as a picture, because the ellipses can be moved and
     * resized without the artwork being redrawn.
     *
     * The second shape sits underneath the first and comes up as the
     * first goes down, so there is always a cloud in the banner.
     */
    .banner__cloud--a {
        animation: cloud-drift 10s linear infinite alternate;
    }

    .banner__cloud--b {
        animation: cloud-drift 10s linear infinite alternate-reverse;
    }

    @keyframes cloud-drift {
        from {
            opacity: 1;
        }
        to {
            opacity: 0;
        }
    }

    /*
     * The drift is a slow movement across the whole banner, which is the
     * kind of thing that causes discomfort for people who have asked
     * their system to reduce motion. The cloud still shows — it simply
     * stops moving.
     */
    @media (prefers-reduced-motion: reduce) {
        .banner__cloud--a,
        .banner__cloud--b {
            animation: none;
        }

        .banner__cloud--b {
            display: none;
        }
    }

    /*
     * The figure.
     *
     * The artwork's own frame is larger than its drawing, so the image is
     * scaled until the drawing is two hundred and twenty tall, and then
     * offset so that the drawing, and not the frame, is what sits in the
     * middle of the banner.
     */
    .banner__front {
        z-index: 1;
        width: 71.85%;
        height: 102.27%;
        left: 14.07%;
        top: -1.36%;

        /*
         * The warrior's arms run off the bottom of the drawing, so the
         * bottom of the banner would otherwise be a hard line across the
         * page. The mask fades the last fifth of the figure out, and the
         * arms dissolve into the cloud.
         *
         * The mask is on the figure rather than on the banner, so the
         * cloud keeps its full strength and only the arms are faded.
         */
        -webkit-mask-image: linear-gradient(to bottom, #000 80%, transparent 100%);
        mask-image: linear-gradient(to bottom, #000 80%, transparent 100%);
    }
</style>
