---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import CardPost from "../components/CardPost.astro";
import Banner from "../components/Banner.astro";
const allJudgements = await getCollection("judgements");
const pageTitle = "Judgements";
---

<Layout pageTitle={pageTitle}>
    <Banner
        name="balance-down-left"
        alt="A balance scale tipping toward the left"
        icons={{ left: 'windows', right: 'linux' }}
    />
    <h1>Judgements</h1>
    <ul role="list" class="link-card-grid">
        {
            allJudgements.map((cardPost) => (
                <CardPost
                    url={`/judgements/${cardPost.id}/`}
                    image={cardPost.data.image.url}
                    title={cardPost.data.title}
                    date={cardPost.data.date}
                    draft={cardPost.data.draft}
                />
            ))
        }
    </ul>
</Layout>
