---
import { getCollection, getEntry, render } from "astro:content";
import MarkdownWarriorLayout from "../../layouts/MarkdownWarriorLayout.astro";

export const prerender = true;
export async function getStaticPaths() {
    const warriorEntries = await getCollection("warriors");
    return warriorEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<MarkdownWarriorLayout frontmatter={entry.data}>
    <div class="prose">
        <Content />
    </div>
</MarkdownWarriorLayout>
