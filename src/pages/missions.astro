---
import { getCollection } from "astro:content";
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import AngelOnMission from '../components/AngelOnMission.astro';
const allMissions = await getCollection("missions");
const pageTitle = "Angelic Assignments";
---
<Layout pageTitle={pageTitle}>
    <AngelOnMission alt="The Angelic Warrior, in flight" />
    <h1>Angelic Assignments</h1>
    <ul role="list" class="link-card-grid">
        {allMissions.map((card) => <Card
            url={`/missions/${card.id}/`}
            image={card.data.image.url}
            title={card.data.title}
            body={card.data.description}
            draft={card.data.draft}
        />)}
    </ul>
</Layout>
