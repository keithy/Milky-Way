---
import { getCollection, getEntry, render } from "astro:content";
import MarkdownJudgementLayout from "../../layouts/MarkdownJudgementLayout.astro";

export const prerender = true;
export async function getStaticPaths() {
    const judgementEntries = await getCollection("judgements");
    return judgementEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<MarkdownJudgementLayout frontmatter={entry.data}>
    <div class="prose">
        <Content />
    </div>
</MarkdownJudgementLayout>
