---
import { getCollection, getEntry, render } from "astro:content";
import MarkdownWeaponLayout from "../../layouts/MarkdownWeaponLayout.astro";

export const prerender = true;
export async function getStaticPaths() {
    const weaponEntries = await getCollection("weapons");
    return weaponEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<MarkdownWeaponLayout frontmatter={entry.data}>
    <div class="prose">
        <Content />
    </div>
</MarkdownWeaponLayout>
