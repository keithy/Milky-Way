---
import BaseLayout from "./Layout.astro";
import Banner from "../components/Banner.astro";
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title} zoomed candidates={frontmatter.candidates}>
    <Banner name={frontmatter.banner?.name} alt={frontmatter.banner?.alt} />
    <h1>{frontmatter.title}</h1>
    <ul class="badge__list">
        <li>
            <span class="badge badge--item">AUTHOR</span>{frontmatter.author}
        </li>
        <li>
            <span class="badge badge--item">PUBLISHED</span>{frontmatter.date}
        </li>
    </ul>
    <slot />
</BaseLayout>
